{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!src/routeTree.gen.ts",
      "!docs",
      "!.claude",
      "!*.md",
      "!*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@scalar/**"],
                "message": "Only src/spec-forms/ may import Scalar (ADR 0004)."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/spec-forms/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@scalar/**"],
                    "message": "Only src/spec-forms/ may import Scalar (ADR 0004)."
                  },
                  {
                    "group": [
                      "~/index-store/**",
                      "**/index-store/**",
                      "~/lookup/**",
                      "**/lookup/**",
                      "~/spec-forms/**",
                      "**/spec-forms/**",
                      "~/server/**",
                      "**/server/**",
                      "~/mcp/**",
                      "**/mcp/**",
                      "~/judge/**",
                      "**/judge/**",
                      "~/fetch/**",
                      "**/fetch/**",
                      "~/sources/**",
                      "**/sources/**"
                    ],
                    "message": "The public CLI (src/cli/) talks to swagger.bot over HTTP only: types from src/domain/, nothing from the server."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
