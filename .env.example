TYPESAFE_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARCH_PROVIDER=
DATABASE_PATH=
# Repo metadata works without it (at a lower rate limit); GitHub code search
# does not. A fine-grained token with public-repository read access is enough.
# Not named GITHUB_TOKEN, which other tools run in this repo (`gh`, agent
# runners) would take as their own credential; GITHUB_TOKEN is still read as a
# fallback.
GITHUB_SEARCH_TOKEN=
# Caps a fetched Spec, in bytes; the fetch is refused past it. Defaults to
# 64 MB (67108864) when unset or not a positive integer.
MAX_SPEC_BYTES=
# Discovery or `fresh` Lookups an API key may make a UTC day, unless the key
# has its own quota. Defaults to 100 when unset or not a positive integer.
DAILY_QUOTA=
# The freshness window, in days: an answer from the Index verified longer ago
# is Stale and queues a background Verification. Defaults to 7.
FRESHNESS_DAYS=
# Requests a client IP may make to POST /api/lookup a minute. Defaults to 60
# when unset or not a positive integer.
RATE_LIMIT_PER_MINUTE=
# The header whose first address is the client IP. Defaults to
# x-forwarded-for; cf-connecting-ip behind Cloudflare.
CLIENT_IP_HEADER=
# The Spec step's deadline, in milliseconds, for known paths, the Developer
# Portal crawl and GitHub code search running at once. Defaults to 9000;
# Infinity turns it off.
SPEC_STEP_BUDGET_MS=
# The public origin download URLs are given under, with no trailing slash
# (https://swaggerbot.dev). Unset, they are paths starting with /api/.
PUBLIC_BASE_URL=

# Slice 7: self-service keys (ADR 0006). Without these, keys stay in SQLite and /keys says they are issued by hand.
UNKEY_ROOT_KEY=
UNKEY_API_ID=
# The API's keyspace (ks_…, on the API's settings page): verification accepts only its keys.
UNKEY_KEYSPACE_ID=
# Only for `scripts/keys.ts migrate`, from Unkey support.
UNKEY_MIGRATION_ID=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# At least 32 characters.
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=

# Slice 9: Ask this Spec (ADR 0007). Without the key (or sign-in) the Spec viewer has no Ask this Spec section and POST /specs/{specId}/ask answers 404.
ANTHROPIC_API_KEY=
# The model that answers. Defaults to claude-opus-5-5.
CHAT_MODEL=
# The model's effort: low, medium, high, xhigh or max. Defaults to low.
CHAT_EFFORT=
# Questions a signed-in person may ask a UTC day. Defaults to 30 when unset or
# not a positive integer.
CHAT_DAILY_TURNS=
# 1 stores each turn's question and answer, for a tuning period; they are
# deleted after 90 days. Unset, only the turn's figures are stored.
CHAT_LOG_TEXT=
# 1, for local checks only. With no ANTHROPIC_API_KEY and no WorkOS sign-in,
# Ask this Spec answers with the chat Benchmark's scripted model, as one
# stand-in person, so scripts/chatcheck.ts can run against a built server.
# With sign-in and no key, development only: every turn is answered by a
# scripted model (no cost; a question starting "Call", "Fetch" or "Run" is
# declined). Refused under NODE_ENV=production.
CHAT_FAKE=
